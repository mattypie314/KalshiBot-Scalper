# Copy to .env on the server (never commit the real file).
# scp separately:  scp .env user@host:/home/user/KalshiBot-Scalper/.env
#                  scp .secrets/kalshi_live.pem user@host:/home/user/KalshiBot-Scalper/.secrets/

KALSHI_API_KEY=
KALSHI_PRIVATE_KEY_PATH=/home/USER/KalshiBot-Scalper/.secrets/kalshi_live.pem
# Leave KALSHI_API_BASE unset for production (external-api.kalshi.com).
# Optional inline PEM instead of path (avoid if you can):
# KALSHI_PRIVATE_KEY=

SCALPER_DASHBOARD_TOKEN=
SCALPER_ASSETS=BTC
SCALPER_BANKROLL=200
# SCALPER_LIVE is forced to 0 by systemd; arm LIVE from the dashboard.
